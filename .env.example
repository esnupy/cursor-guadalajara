# Admin dashboard environment variables

# Database
# Local: Neon `development` branch connection string
# Production: Neon `main` branch connection string
DATABASE_URL=

# Neon Auth (branch-specific base URL from Neon Console)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Local development auth bypass (never enable in production)
AUTH_DEV_BYPASS=true
DEV_USER_EMAIL=juanda.martinezn@gmail.com
DEV_SESSION_SECRET=

# GitHub OAuth — configure in Neon Console per branch
# Callback URL: {NEON_AUTH_BASE_URL}/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Speaker applications at /charlas (optional extra destination; Neon is the default store)
# CHARLAS_WEBHOOK_URL=
# CHARLAS_WEBHOOK_TOKEN=
